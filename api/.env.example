# Exemplo para Neon/Postgres. Substitua pelos valores do Neon Console.
# Ex: postgresql://<user>:<password>@<host>:5432/<db>?sslmode=require
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/corte_fino"

# Campos opcionais (mantidos para referência)
DATABASE_USER="postgres"
DATABASE_PASSWORD="SUA_SENHA"
DATABASE_NAME="corte_fino"
DATABASE_HOST="localhost"
DATABASE_PORT=5432

MAILTRAP_EMAIL=""
MAILTRAP_SENHA=""

